      "projectId": "proj-devjournal",
      "category": "build",
      "title": "Migrated to ESLint Flat Config for Next 16",
      "templateData": {
        "subcategory": "til-snippet",
        "tilSnippet": {
          "problem": "`next lint` no longer works in Next.js 16 CLI for this setup.",
          "solution": "Use `eslint .` via `package.json` and provide `eslint.config.mjs` that loads Next/React rules with core-web-vitals.",
          "code": "// package.json\\n\"lint\": \"eslint .\"\\n\\n// eslint.config.mjs\\n...nextPlugin.configs[\"core-web-vitals\"].rules"
        }
      },
      "isPublic": true,

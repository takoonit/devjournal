    {
        "id": "entry-decision",
        "projectId": "proj-devjournal",
        "category": "plan-change",
        "title": "Pivot to Hybrid Templates",
        "templateData": {
          "subcategory": "decision-log",
          "decisionLog": {
              "context": "User felt 'empty markdown' lacked guidance, but 'strict forms' felt like tax documents.",
              "options": "1. Revert to strict forms.\n2. Keep empty markdown.\n3. Hybrid (Structured Input -> Narrative Output).",
              "decision": "Option 3: Hybrid.",
              "rationale": "We need the *prompting* of a form to unblock the user, but the *readability* of a story for the timeline."
          }
        },
        "isPublic": true,
        "createdAt": "2026-02-09T10:00:00.000Z",
        "updatedAt": "2026-02-09T10:00:00.000Z"
      },
    {
      "id": "entry-debugging",
      "projectId": "proj-devjournal",
      "category": "build",
      "title": "Fixing Circular Type Dependencies",
      "templateData": {
        "subcategory": "debugging",
        "debugging": {
            "symptom": "TypeScript error: `EntryTemplateData` circularly references itself.",
            "hypothesis": "I defined the union type incorrectly in `types.ts`.",
            "attempted": "- Checked imports\n- Simplified unions",
            "solution": "Separated the interfaces for Plan, Build, and Reflect into distinct types before unionizing them."
        }
      },
      "isPublic": true,
      "createdAt": "2026-02-09T14:30:00.000Z",
      "updatedAt": "2026-02-09T14:30:00.000Z"

      "id": "entry-decision",
      "projectId": "proj-devjournal",
      "category": "plan-change",
      "title": "Pivot to Hybrid Templates",
      "templateData": {
        "subcategory": "decision-log",
        "decisionLog": {
          "context": "User felt 'empty markdown' lacked guidance, but 'strict forms' felt like tax documents.",
          "options": "1. Revert to strict forms.\n2. Keep empty markdown.\n3. Hybrid (Structured Input -> Narrative Output).",
          "decision": "Option 3: Hybrid.",
          "rationale": "We need the *prompting* of a form to unblock the user, but the *readability* of a story for the timeline."
        }
      },
      "isPublic": true,
      "createdAt": "2026-02-09T10:00:00.000Z",
      "updatedAt": "2026-02-09T10:00:00.000Z"
